{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/setup-webhook", "dest": "/api/setup-webhook.js" },
    { "src": "/api/debug-storage", "dest": "/api/debug-storage.js" },
    { "src": "/api/webhook", "dest": "/api/webhook.js" }
  ],
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60
    }
  }
}
