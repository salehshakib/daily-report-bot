{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60
    },
    "api/cron-active-task.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-active-task",
      "schedule": "30 12 * * *"
    }
  ]
}
